{
  "$schema": "https://opencode.ai/config.json",
  // リポジトリ共通の安全境界 (#10)。
  // エージェント個別の permissions の前に適用される。後勝ち (last matching rule wins)。
  "permissions": [
    // 履歴書き換え・ブランチ削除 (強制的な破壊的操作の抑止)
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * --delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push * :refs*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -D*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard*", "effect": "ask" },
    { "action": "shell", "resource": "git clean*", "effect": "ask" },
    // Human-on-the-Loop: マージは人間が行う。エージェントによるマージ操作を禁止
    { "action": "shell", "resource": "gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "gh api * -X PUT*", "effect": "deny" },
    // リポジトリ自体の破壊的操作
    { "action": "shell", "resource": "gh repo delete*", "effect": "deny" },
    { "action": "shell", "resource": "gh release delete*", "effect": "ask" },
    // 秘密情報の shell 経由読み取り (read ツール経由は既定ポリシーで ask)
    { "action": "shell", "resource": "* .env*", "effect": "deny" }
  ]
}
